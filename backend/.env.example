# CoopConnect Backend Environment Configuration

# Neon PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-still-bread-b53vsdcy-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security (JWT)
SECRET_KEY=coopconnect_production_secret_key_2026_fair_work
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Configuration (Optional)
AI_API_KEY=

# Gmail SMTP Email OTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_google_app_password
OTP_EXPIRY=300
OTP_SECRET_SALT=coopconnect_otp_secure_salt_2026

# Temporary Development Dummy OTP Mode (for local testing without live SMTP)
# Set to 'true' to allow dummy OTP 123456 and skip email sending.
# Defaults to 'false'. Strictly rejected in production environments.
DEV_DUMMY_OTP_ENABLED=false

# Razorpay TEST MODE Configuration
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

